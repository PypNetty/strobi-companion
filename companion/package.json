{
  "name": "desktop-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Windows desktop companion that reuses the Avatar Lab procedural engine.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "postinstall": "node scripts/copy-mediapipe.mjs && node scripts/write-icon.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@tauri-apps/api": "^2.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.10"
  }
}
